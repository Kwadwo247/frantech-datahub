# ==============================================================================
# SellBundle Environment Configuration
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SETTINGS
# ------------------------------------------------------------------------------
# In production, set DEBUG=False and generate a strong, random 50+ character secret key.
DEBUG=True
SECRET_KEY=django-insecure-change-me-for-production-sellbundle-2026-secret-key!
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Set USE_POSTGRESQL=True when your PostgreSQL database is ready.
# If False, the project falls back to SQLite for instant local development.
USE_POSTGRESQL=True

# Fill in your local or hosted PostgreSQL credentials below:
DB_NAME=sellbundle_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. PAYSTACK PAYMENT GATEWAY CREDENTIALS (Ghana MoMo + Card)
# ------------------------------------------------------------------------------
# Obtain these from your Paystack Dashboard (https://dashboard.paystack.com/#/settings/developer)
# Use 'test' keys (sk_test_... and pk_test_...) during development.
# Use 'live' keys (sk_live_... and pk_live_...) for production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
# Webhook secret to verify incoming Paystack charge events
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. VENDOR / AGGREGATOR API CREDENTIALS (mydatagigs.com)
# ------------------------------------------------------------------------------
# Generate your API key at https://mydatagigs.com/my-account/api-access/
VENDOR_BASE_URL=https://mydatagigs.com/wp-json/custom/v1
VENDOR_API_KEY=your_mydatagigs_api_key_here
VENDOR_API_SECRET=

# ------------------------------------------------------------------------------
# 5. CELERY & REDIS CONFIGURATION (Asynchronous task queue)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery broker and result storage
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True for instant synchronous task execution during local testing without Redis
CELERY_TASK_ALWAYS_EAGER=True

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND SETTINGS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 7. GHANA SMS GATEWAY CONFIGURATION (Arkesel / mNotify / Hubtel)
# ------------------------------------------------------------------------------
# Choose active provider: 'arkesel', 'mnotify', 'hubtel', or 'sandbox'
SMS_ENABLED=True
SMS_PROVIDER=arkesel
SMS_SENDER_ID=SellBundle

# Arkesel API key (https://arkesel.com)
ARKESEL_API_KEY=your_arkesel_api_key_here

# mNotify API key (https://mnotify.com)
MNOTIFY_API_KEY=your_mnotify_api_key_here

# Hubtel SMS credentials (https://hubtel.com)
HUBTEL_CLIENT_ID=your_hubtel_client_id_here
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_here
